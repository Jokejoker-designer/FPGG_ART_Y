{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    /* The frozen contract package ships TypeScript source and uses explicit
       `.ts` extensions on its internal imports so it also runs unbundled under
       `node --test`. Vite resolves those; tsc needs to be told. */
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "e2e", "audit"],
  /* Stories were written against @storybook/nextjs-vite. Storybook is being
     re-established on the Vite builder, and the import specifier changes with
     it; until then they are out of the typecheck rather than deleted, because
     the state coverage they encode is worth keeping. Tracked as a pending task
     and as a blocking finding in the migration review. */
  "exclude": ["src/**/*.stories.tsx", "src/workers/**"]
}
